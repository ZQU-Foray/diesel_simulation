# 调车用全量视图（I11）。验收最小集见 sim.rviz，本文件只做调试支撑、不参与 A0–A7 判定。
#
# 用法：ros2 launch diesel_simulation_bringup navigation_sim.launch.py gui:=true \
#           rviz:=true rviz_config:=tune.rviz
# 说明：RViz 退出时会重写本文件（注释与默认值会被压缩），调试中的临时改动不要直接提交。
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Root Node Name: Displays
  - Class: rviz_common/Views
    Name: Views
    Root Node Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: false
      Name: Grid
      Cell Size: 1
      Color: 160; 160; 160
      Line Style: Lines
      Plane: XY
      Plane Cell Count: 10
    # 机器人本体：robot_state_publisher 已把 SDF 发到 /robot_description
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /robot_description
      TF Prefix: ""
      Visual Enabled: true
      Collision Enabled: false
    # Show Names 打开：调车时先看 map→odom→base_footprint→front_mid360 断在哪一环
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Marker Scale: 1
      Show Arrows: false
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: registered_scan
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Value: /cloud_registered
      Size (m): 0.05
      Style: Points
      Color Transformer: AxisColor
    # 原始点云默认关：软件渲染下开着会和 registered 抢带宽
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: livox_raw
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Value: /livox/lidar
      Size (m): 0.02
      Style: Points
      Color Transformer: AxisColor
    # 先验图（diesel_map_server 发布）与派生导航栅格（global_costmap 的静态层来自
    # map/nav2/rmul_2027_nav.yaml）叠看：D16 的清隧道效果要能在图上直接看出来
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: prior_map
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /map
      Alpha: 0.6
      Color Scheme: map
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: global_costmap
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
      Alpha: 0.5
      Color Scheme: costmap
      Draw Behind: true
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: local_costmap
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
      Alpha: 0.7
      Color Scheme: costmap
    - Class: rviz_default_plugins/Polygon
      Enabled: true
      Name: footprint
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /local_costmap/published_footprint
      Alpha: 1
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: global_plan
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /plan
      Alpha: 1
      Buffer Length: 1
      Line Style: Lines
      Line Width: 0.03
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: local_plan
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /local_plan
      Alpha: 1
      Buffer Length: 1
      Line Style: Lines
      Line Width: 0.05
      Color: 0; 255; 0
    # 累积轨迹需要 Odometry 的 Keep 属性，是否可用待容器实测（plan.md I11）；
    # 这里先只画当前位姿箭头，历史轨迹交给 scripts/tune_report.py 的文本报告
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: odometry
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /odometry
      Angle Tolerance: 0.1
      Position Tolerance: 0.1
      Covariance:
        Orientation: false
        Position: false
      Shape:
        Color: 0; 255; 0
        Head Length: 0.1
        Head Radius: 0.06
        Shaft Length: 0.3
        Shaft Radius: 0.03
  Enabled: true
  Global Options:
    Fixed Frame: map
    Background Color: 32; 32; 32
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    # 量隧道净空用
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Topic:
        Value: /clicked_point
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 20
      Target Frame: map
      X: 6
      Y: 4
    Saved:
      - Class: rviz_default_plugins/TopDownOrtho
        Name: TopDownOrtho
        Scale: 20
        Target Frame: map
        X: 6
        Y: 4
      - Class: rviz_default_plugins/Orbit
        Name: Orbit
        Distance: 12
        Focal Point:
          X: 6
          Y: 5.5
          Z: 1
        Pitch: 0.6
        Yaw: 0.7
Window Geometry:
  Height: 900
  Width: 1400
