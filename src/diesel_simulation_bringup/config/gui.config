<?xml version="1.0"?>
<!-- Gazebo GUI 布局（I12）：3D 视图沿用迁移包的场地视角，四角补调车要用的面板。
     x/y 是窗口内绝对像素位置，不随窗口缩放重排；改面板尺寸时同步改邻居的 y。

     容器内校核（宿主无 gz）：`ign gui -l` 打印已注册插件名，`gz sim` 起来后
     逐个确认面板真的出现——插件类名写错时 gz 只会在终端留一行
     「Failed to load plugin」，窗口里什么都不显示。

     WorldControl 的 `<service>` 与 WorldStats 的 `<topic>` 故意不写：不写才按
     当前世界名推导（/world/rmul_2027/…）；写死会在换世界后静默失效。 -->
<gui version="1.0">
    <plugin filename="MinimalScene" name="3D View">
        <ignition-gui>
            <title>3D View</title>
            <property type="bool" key="showTitleBar">false</property>
        </ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <camera>
            <pose>6 4 12 0 0.62 2.18</pose>
            <horizontal_fov>1.047</horizontal_fov>
        </camera>
    </plugin>
    <plugin filename="GzSceneManager" name="Scene Manager">
        <ignition-gui>
            <property key="resizable" type="bool">false</property>
            <property key="x" type="double">0</property>
        </ignition-gui>
    </plugin>
    <plugin filename="WorldControl" name="World control">
        <ignition-gui>
            <title>World control</title>
            <property type="bool" key="resizable">false</property>
            <property type="double" key="height">64</property>
            <property type="double" key="width">200</property>
            <property type="double" key="x">0</property>
            <property type="double" key="y">0</property>
        </ignition-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <!-- 必须显式 false：true 会让世界一启动就停在暂停态，A2/A3 与调车全都拿不到数据 -->
        <start_paused>false</start_paused>
    </plugin>
    <plugin filename="WorldStats" name="World stats">
        <ignition-gui>
            <title>World stats</title>
            <property type="bool" key="resizable">false</property>
            <property type="double" key="height">120</property>
            <property type="double" key="width">260</property>
            <property type="double" key="x">0</property>
            <property type="double" key="y">64</property>
        </ignition-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
    </plugin>
    <plugin filename="EntityTree" name="Entity tree">
        <ignition-gui>
            <title>Entity tree</title>
            <property type="double" key="height">500</property>
            <property type="double" key="width">280</property>
            <property type="double" key="x">1120</property>
            <property type="double" key="y">0</property>
        </ignition-gui>
    </plugin>
    <plugin filename="ComponentInspector" name="Component inspector">
        <ignition-gui>
            <title>Component inspector</title>
            <property type="double" key="height">400</property>
            <property type="double" key="width">280</property>
            <property type="double" key="x">1120</property>
            <property type="double" key="y">500</property>
        </ignition-gui>
    </plugin>
</gui>
